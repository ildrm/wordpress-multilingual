{
  "name": "multilingual-core/multilingual-core",
  "description": "A performance-first multilingual platform for WordPress.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
	"php-stubs/wordpress-stubs": "^6.9",
	"php-stubs/wp-cli-stubs": "^2.12",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0",
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.2",
    "phpcompatibility/phpcompatibility-wp": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "MultilingualCore\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MultilingualCore\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs",
	"analyse": "phpstan analyse --debug --memory-limit=-1",
    "check": ["@lint", "@analyse", "@test"],
    "package": "php bin/package.php"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  }
}
