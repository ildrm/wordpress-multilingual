<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap/unit.php" colors="true" cacheDirectory="build/phpunit-cache">
	<testsuites>
		<testsuite name="unit">
			<directory suffix="Test.php">tests/Unit</directory>
		</testsuite>
	</testsuites>
	<source>
		<include><directory suffix=".php">src/Domain</directory></include>
	</source>
</phpunit>

